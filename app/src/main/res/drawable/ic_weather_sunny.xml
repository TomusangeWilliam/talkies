    android:viewportHeight="48">

    <!-- Outer glow ring -->
    <path
        android:pathData="M24,24m-18,0a18,18 0,1 1,36 0a18,18 0,1 1,-36 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="24"
                android:centerY="24"
                android:gradientRadius="18"
                android:type="radial">
                <item android:offset="0.6" android:color="#33FFD54F"/>
                <item android:offset="1.0" android:color="#00FFD54F"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sun rays (8 rays) -->
    <path android:fillColor="#FFD54F"
        android:pathData="M24,4 L25.2,8.8 L24,9.5 L22.8,8.8 Z"/>
    <path android:fillColor="#FFD54F"
        android:pathData="M24,44 L22.8,39.2 L24,38.5 L25.2,39.2 Z"/>
    <path android:fillColor="#FFD54F"
        android:pathData="M4,24 L8.8,22.8 L9.5,24 L8.8,25.2 Z"/>
    <path android:fillColor="#FFD54F"
        android:pathData="M44,24 L39.2,25.2 L38.5,24 L39.2,22.8 Z"/>
    <path android:fillColor="#FFD54F"
        android:pathData="M7.76,7.76 L11.24,11.24 L10.18,12.3 L7.76,10.24 Z"/>
    <path android:fillColor="#FFD54F"
        android:pathData="M40.24,40.24 L36.76,36.76 L37.82,35.7 L40.24,37.76 Z"/>
    <path android:fillColor="#FFD54F"
        android:pathData="M40.24,7.76 L37.76,10.24 L36.7,9.18 L38.76,6.76 Z"/>
    <path android:fillColor="#FFD54F"
        android:pathData="M7.76,40.24 L10.24,37.76 L11.3,38.82 L9.24,41.24 Z"/>

    <!-- Sun body with 3D radial gradient -->
    <path
        android:pathData="M24,24m-10,0a10,10 0,1 1,20 0a10,10 0,1 1,-20 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="20"
                android:centerY="19"
                android:gradientRadius="12"
                android:type="radial">
                <item android:offset="0"   android:color="#FFFFFF"/>
                <item android:offset="0.3" android:color="#FFE57F"/>
                <item android:offset="0.7" android:color="#FFB300"/>
                <item android:offset="1.0" android:color="#E65100"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Specular highlight (top-left shine) -->
    <path
        android:pathData="M18,18 Q19,15 22,16 Q20,17 19,19 Z"
        android:fillColor="#FFFFFFFF"/>
</vector>
