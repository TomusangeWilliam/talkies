<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:type="radial"
        android:centerX="50%"
        android:centerY="40%"
        android:gradientRadius="65%"
        android:startColor="#3A3E57"
        android:centerColor="#232A3A"
        android:endColor="#171C2C" />
    <stroke
        android:width="1.5dp"
        android:color="#7DD3FC" />
    <padding
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp" />
</shape>
